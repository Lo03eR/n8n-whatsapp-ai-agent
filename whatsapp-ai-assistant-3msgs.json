      "parameters": {
        "jsCode": "const out = $node[\"AI Agent\"].json.output || \"\";\nconst chatId = $('Webhook').item.json.body.senderData.chatId;\n// Режем ответ ИИ на отдельные сообщения по разделителю |||\nconst parts = out\n  .split('|||')\n  .map(s => s.trim())\n  .filter(s => s.length > 0);\n// Если разделителя не было — уходит одним сообщением\nreturn parts.map(p => ({ json: { chatId, message: p } }));"
      },
