# Скопируй этот файл в .env и заполни значения:
#     cp .env.example .env
# Сгенерировать KEY и SECRET (две случайные строки):
#     openssl rand -hex 32
#     openssl rand -hex 32
#
# ⚠️  БЕЗОПАСНОСТЬ: проверь Directus Public Role (Settings → Roles → Public):
#   - articles:  read ✅
#   - ads:       read ✅
#   - certificates: read ✅ (только поля: number, fio, type, date_created)
#   - publish_requests: ЗАКРЫТЬ (содержит ФИО, контакты, чеки)
#   - directus_files:   ЗАКРЫТЬ
#   - directus_users:   ЗАКРЫТЬ

DIRECTUS_KEY=ЗАМЕНИ_случайная_строка_1
DIRECTUS_SECRET=ЗАМЕНИ_случайная_строка_2

# Логин первого администратора (им зайдёшь в админку)
ADMIN_EMAIL=admin@ulagattyustaz.kz
ADMIN_PASSWORD=ЗАМЕНИ_надёжный_пароль

# Публичный адрес API (поддомен для Directus)
PUBLIC_URL=https://api.ulagattyustaz.kz

# Домен самого сайта (для CORS). Для проверки по IP можно временно: *
SITE_ORIGIN=https://ulagattyustaz.kz

# ---- Telegram-бот (заполнить при запуске бота; см. bot/README.md) ----
# Токен бота от @BotFather:
BOT_TOKEN=
# Chat id администратора (куда боту слать заявки). Узнать: напиши боту /id
ADMIN_CHAT_ID=
# Статический токен пользователя-бота в Directus (создаётся в админке):
DIRECTUS_TOKEN=

# Дефолтные Kaspi-реквизиты (админ может менять через бота, но нужны начальные):
DEFAULT_PRICE=1000
DEFAULT_KASPI_NUMBER=
DEFAULT_KASPI_NAME=
